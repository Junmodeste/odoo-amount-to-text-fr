<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='total']" position="after">
            <p class="text-end lh-sm" name="amount_total_words_fr" t-if="o.amount_total_words_fr">
                Amount in words: <br/>
                <small class="text-muted"><span t-field="o.amount_total_words_fr">Mille francs CFA</span></small>
            </p>
        </xpath>
    </template>
</odoo>
